# Předloha env souborů appky (vrstva 1: co se liší podle prostředí nebo je tajemství). Jediný env
# soubor v gitu, hodnoty jsou jen ukázkové. Skutečné soubory leží vedle něj a do gitu nepatří:
# .env.development (lokální vývoj) a .env (produkce, nahrává se s appkou na App Engine).
#
# Štítky v komentářích přímo nad klíčem (souvislý blok řádků s #, prázdný řádek ho končí) říkají,
# kde je klíč povinný; velikost písmen nehraje roli:
#   bez štítku     klíč stacku podle registru caio-serveru, vlastní klíč appky povinný všude
#   [optional]     nepovinný
#   [required]     povinný všude (s [production] jen v produkčních souborech)
#   [local]        jen .env.development, nikdy povinný -- v produkčním souboru je chyba
#   [production]   povinný jen v produkčních souborech
# `npm run check-env` porovná env soubory s touhle předlohou a s registrem klíčů caio-serveru
# (vypisuje jen klíče, nikdy hodnoty); `npm run dev` jen upozorní, `npm run deploy` se zastaví.
#
# Co v env souborech není: platnost přihlášení (server/server.config.js `auth.jwtLifetime`, dřív
# JWT_LIFETIME), odchozí pošta a e-mail majitele, účet, údaje k příjezdu a dodavatel na faktuře
# (Nastavení v administraci, dřív SMTP_*, MAIL_FROM, OWNER_EMAIL a server/config.js).

# --- Server ---
# [optional] Port serveru (výchozí 8080); na App Engine ho nastavuje platforma sama.
PORT=8080
# Databáze. Lokálně vlastní databáze appky, v produkci Atlas BEZ query stringu za jménem databáze
# (caio-server si `?retryWrites=…` lepí sám; z dialogu „Connect“ v Atlasu všechno od `?` umazat).
MONGODB_URI=mongodb://127.0.0.1:27017/propertyman
# Klíč pro podepisování přihlašovacích tokenů. V produkci silný a jiný než lokálně.
JWT_SECRET=change-me-at-least-32-characters-long
# [production] Veřejná adresa webu bez lomítka na konci: odkazy v e-mailech, sitemap.xml, canonical,
# og:image a strukturovaná data (build ji zapéká, po změně je potřeba nový build).
APP_URL=https://roubenka.example
# [optional] Hlavní host; alias (www) se na něj přesměruje (301). Musí sedět s APP_URL.
CANONICAL_HOST=roubenka.example
# Klíč pro šifrování tajných hodnot Nastavení (heslo SMTP v sys_settings), 32 bajtů v base64. Bez něj
# heslo do Nastavení uložit nejde a `npm run settings-import` heslo z .env nepřenese; změna klíče
# uložené heslo znečitelní. Vygeneruje ho
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# [optional]
SETTINGS_SECRET_KEY=

# --- Přihlášení (caio-devkit docs/login.md) ---
# Prázdné = Google se nenabídne, zůstává e-mail a heslo. Callback v Google Cloud musí mířit na
# https://<doména>/auth/google/callback.
# [optional]
GOOGLE_CLIENT_ID=000000000000-dummy.apps.googleusercontent.com
# [optional]
GOOGLE_CLIENT_SECRET=dummy-google-secret

# --- Soubory (caio-devkit docs/how-to-set-gcs.md) ---
# Bucket pro binárky; lokálně a v produkci každý svůj.
# [required]
GCS_BUCKET_NAME=propertyman-binary-dev

# --- reCAPTCHA v3 (rezervační formulář, docs/decisions.md „Ochrana formuláře“) ---
# Dvojice z Google Cloud -> Fraud Defense -> Keys; vyplňují se obě, nebo žádná. Secret je u klíče
# pod Integration -> Use Legacy Key. Bez něj server v produkci odmítne každou rezervaci (503),
# v developmentu formulář projde bez captchy.
# [required] [production]
GOOGLE_RECAPTCHA_SECRET=dummy-recaptcha-secret
# Site key je veřejný (je v každé stránce), do bundlu ho dává caio-devkit. Do 2026-11
# GOOGLE_RECAPTCHA_API_KEY v client/.env.development. Domény se nastavují u klíče (localhost
# i produkční doména).
# [required] [production]
GOOGLE_RECAPTCHA_SITE_KEY=dummy-recaptcha-site-key

# --- Google Maps (mapa v kontaktu) ---
# Klíč pro Maps Embed API; do bundlu ho dává caio-devkit (caio.config.js `env.client`), za běhu se
# nečte. Je veřejný v URL iframu, proto v Google Cloud omezený na HTTP referrery (localhost:8080
# i produkční doména) a jen na Maps Embed API. Prázdný = v kontaktu zůstane placeholder s odkazem
# do Google Maps. Do 2026-11 v client/.env.development.
# [production]
GOOGLE_MAPS_API_KEY=dummy-maps-key

# --- iCal (design-v2.md § 8) ---
# Sdílený secret pro cron volání POST /calendar/sync (hlavička X-Ical-Sync-Secret). Prázdný = sync
# z cronu vrací 503, ruční sync z administrace jede dál. Feedy portálů se zadávají v administraci.
# [optional]
ICAL_SYNC_SECRET=dummy-ical-sync-secret

# --- Jen lokálně ---
# [local] [optional] Port Vite dev serveru (dřív VITE_PORT v client/.env.development); `npm run dev`
# ho nepoužívá.
CLIENT_PORT=3000
# Testovací účet pro QA v prohlížeči (`npm run qa-accounts`, jen proti lokální databázi): e-mail,
# heslo a role (ADMIN bez ROLES dostane authorities). Heslo si zvol sám, sem nepatří.
# [local] [optional]
QA_ADMIN_EMAIL=qa-admin@roubenka.test
# [local] [optional]
QA_ADMIN_PASSWORD=
# [local] [optional]
QA_ADMIN_ROLES=authorities
