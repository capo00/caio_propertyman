# Co se NEnahrává do App Engine. Syntaxe je stejná jako .gitignore.
# Reálný seznam k nahrání: gcloud meta list-files-for-upload

# Zdrojáky klienta -- do produkce jde jen sestavený public/, který z nich vzniká.
client/

# App Engine si závislosti nainstaluje sám z package.json + package-lock.json.
node_modules/

.git
.gitignore
.gitattributes

# Env soubory: nahrává se JEN .env a .env.example. .env je produkční konfigurace (MONGODB_URI,
# GCS_BUCKET_NAME, OAuth), server ho čte přes dotenv -- bez něj appka v produkci nemá konfiguraci.
# .env.example nese jen ukázkové hodnoty, sys/health z něj pozná neznámé a chybějící klíče.
# Všechno ostatní zůstává doma: .env.development, *.local, zálohy a další .env.<cíl>.
.env*
!.env
!.env.example
*.local

# Pracovní výstupy z vývoje (náhledy e-mailů apod.), v gitu taky nejsou (.gitignore).
tmp/

# Designové podklady a dokumentace -- server je za běhu nečte a v public/ nejsou,
# takže se na App Engine jen nahrávaly a ležely tam.
ux/
docs/
design.md
design-v1.md
README.md

# Sám sebe -- gcloud ho čte lokálně, na App Engine nemá co dělat.
.gcloudignore
