# Výchozí registry. uu5*/uu_appdatatypesg02 na npmjs nejsou -- a zároveň tím přebíjíme
# případný jiný default v ~/.npmrc.
registry=https://repo.plus4u.net/repository/public-javascript/

# Stack caio. Scope musí sedět s vlastníkem repozitářů na GitHubu.
#
# Token se sem NEPÍŠE: `${NPM_TOKEN}` si npm expanduje z prostředí. Na stroji se nastaví
# jednou (proměnná prostředí NPM_TOKEN, klasický PAT se scope `read:packages`), do
# Cloud Buildu ho při deployi doplní `caio-devkit deploy`. Chybějící proměnnou npm
# nezastaví hned -- prostě pošle prázdný token a instalace `@capo00/*` skončí na 401.
@capo00:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}
