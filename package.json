{
  "name": "caio_propertyman",
  "version": "0.2.9",
  "type": "module",
  "main": "server/index.js",
  "caio": {
    "languages": [
      "cs",
      "en",
      "sk",
      "pl",
      "de"
    ],
    "deploy": {
      "project": "caio-propertyman",
      "keepVersions": 3
    }
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "caio-devkit start",
    "sync": "caio-devkit link-local",
    "build": "caio-devkit build",
    "deploy": "caio-devkit deploy",
    "release": "caio-devkit release --app",
    "grant-role": "caio-devkit grant-role",
    "test": "node --test --import caio-server/test-setup \"server/**/*.test.js\" \"client/src/**/*.test.js\"",
    "email:preview": "node tools/email-preview.js",
    "invoice:preview": "node tools/invoice-preview.js",
    "qa-accounts": "caio-devkit qa-accounts"
  },
  "dependencies": {
    "caio-server": "npm:@capo00/caio-server@^0.4.4",
    "ical.js": "^2.2.1",
    "pdfmake": "^0.3.11",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "caio-devkit": "npm:@capo00/caio-devkit@^0.4.6",
    "nodemon": "^3.1.14"
  }
}
